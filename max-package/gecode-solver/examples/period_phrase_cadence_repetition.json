      "id": "no_adjacent_repeat_soprano",
      "rule_type": "wildcard_constraint",
      "wildcard_type": "for_all_voices",
      "pattern_offsets": [0, 1],
      "constraint": "voice[v].pitch[i] != voice[v].pitch[i+1]",
      "target_voices": [0],
      "target_component": "pitch",
      "description": "Hard: soprano no immediately repeated pitch, so the contour has real steps to compare"
    },
    {
      "id": "half_cadence_antecedent",
      "rule_type": "r-cadence",
      "cadence_type": "HC",
      "positions": [6, 7],
      "target_voices": [0, 1, 2, 3],
      "description": "Antecedent ends on V (ii-V half cadence) at position 7"
    },
    {
      "id": "authentic_cadence_consequent",
      "rule_type": "r-cadence",
      "cadence_type": "PAC",
      "positions": [14, 15],
      "target_voices": [0, 1, 2, 3],
      "description": "Consequent ends in a full authentic cadence (V7-I, root position, soprano on tonic)"
    },
    {
      "id": "final_seventh_resolves_down",
      "rule_type": "r-tendency-tone",
      "tendency": "chordal_seventh",
      "positions": [14, 15],
      "target_voices": [0, 1, 2, 3],
      "description": "Whichever voice holds the final V7's 7th at position 14 must resolve it down by step at position 15"
    },
