{
  "name": "MusicXML accidental state regression",
  "description": "In G major, force F-natural then F-sharp within bar 1, then F-natural again before a barline and F-sharp at bar 2's start. The accidental must be repeated after the natural in bar 1, then reset to the key signature in bar 2.",
  "solution_length": 5,
  "num_voices": 1,
  "search_options": {
    "engine": "dfs",
    "enable_metric_engine": 0,
    "random_seed": 1,
    "timeout_ms": 10000,
    "branching": "first_fail",
    "value_order": "min"
  },
  "export_json": false,
  "export_txt": false,
  "export_xml": true,
  "file_name": "output/musicxml_accidental_state_test",
  "voices": [
    {
      "name": "Test voice",
      "pitch": { "midi_values": [65, 66] },
      "rhythm": { "duration_values": ["1/4"] }
    }
  ],
  "rules": [
    {
      "id": "force_f_natural",
      "rule_type": "wildcard_constraint",
      "wildcard_type": "for_all_positions",
      "pattern_offsets": [0],
      "indices": [0],
      "constraint": "voice[0].pitch[i] == 65",
      "target_voices": [0],
      "target_component": "pitch"
    },
    {
      "id": "force_f_sharp",
      "rule_type": "wildcard_constraint",
      "wildcard_type": "for_all_positions",
      "pattern_offsets": [0],
      "indices": [1],
      "constraint": "voice[0].pitch[i] == 66",
      "target_voices": [0],
      "target_component": "pitch"
    },
    {
      "id": "keep_f_sharp",
      "rule_type": "wildcard_constraint",
      "wildcard_type": "for_all_positions",
      "pattern_offsets": [0],
      "indices": [2],
      "constraint": "voice[0].pitch[i] == 66",
      "target_voices": [0],
      "target_component": "pitch"
    },
    {
      "id": "force_f_natural_again",
      "rule_type": "wildcard_constraint",
      "wildcard_type": "for_all_positions",
      "pattern_offsets": [0],
      "indices": [3],
      "constraint": "voice[0].pitch[i] == 65",
      "target_voices": [0],
      "target_component": "pitch"
    },
    {
      "id": "f_sharp_after_barline",
      "rule_type": "wildcard_constraint",
      "wildcard_type": "for_all_positions",
      "pattern_offsets": [0],
      "indices": [4],
      "constraint": "voice[0].pitch[i] == 66",
      "target_voices": [0],
      "target_component": "pitch"
    }
  ],
  "harmonic_domain": [{ "beat": 0, "degree": "I", "key": "G", "mode": "major" }]
}
