{
  "name": "r-repetition test — transposed sequence",
  "description": "Minimal repro: single voice, 8 notes. Bar 1 (pos 0-3) is a motif; bar 2 (pos 4-7) is the same motif transposed up 2 semitones. Verifies the 'transposed' relation as a hard constraint.",
  "solution_length": 8,
  "num_voices": 1,
  "search_options": {
    "engine": "dfs",
    "enable_metric_engine": 0,
    "random_seed": 0,
    "timeout_ms": 10000,
    "branching": "first_fail",
    "value_order": "min"
  },
  "export_json": false,
  "export_txt": true,
  "export_xml": false,
  "file_name": "output/repetition_transposed_test",
  "voices": [
    {
      "name": "Melody",
      "pitch": {
        "midi_values": [
          60, 61, 62, 63, 64, 65, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76
        ]
      },
      "rhythm": { "duration_values": ["1/4"] }
    }
  ],
  "rules": [
    {
      "id": "no_adjacent_repeat",
      "rule_type": "wildcard_constraint",
      "wildcard_type": "for_all_voices",
      "pattern_offsets": [0, 1],
      "constraint": "voice[v].pitch[i] != voice[v].pitch[i+1]",
      "target_voices": [0],
      "target_component": "pitch",
      "description": "Hard: no immediately repeated pitch (forces the motif to actually move)"
    },
    {
      "id": "seq_transposed",
      "rule_type": "r-repetition",
      "relation": "transposed",
      "transpose_semitones": 2,
      "source_positions": [0, 1, 2, 3],
      "target_positions": [4, 5, 6, 7],
      "target_voices": [0],
      "enabled": true,
      "description": "Bar 2 is bar 1 transposed up a whole step"
    }
  ]
}
